# ─────────────────────────────────────────────────────────────
# SHFTD environment configuration
# Copy to `.env.local` and fill in. The app runs in DEMO MODE with
# mock data when these are absent, so you can develop with zero setup.
# ─────────────────────────────────────────────────────────────

# Toggle. When "true" (or when Supabase vars are missing) the app uses
# in-memory mock data instead of hitting Supabase. Great for demos.
NEXT_PUBLIC_DEMO_MODE=true

# ── Supabase ──────────────────────────────────────────────────
# TODO: create a project at https://supabase.com and paste keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / LLM provider ─────────────────────────────────────────
# The AI service layer (src/lib/ai) falls back to deterministic mock
# generation when no key is set. Anthropic is preferred when both exist.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI is still supported as a fallback provider (optional).
OPENAI_API_KEY=
# Optional model override. Defaults to claude-sonnet-4-6 when ANTHROPIC_API_KEY
# is set, or gpt-4o-mini for OpenAI.
SHFTD_AI_MODEL=

# ── Stripe Connect (payouts) ──────────────────────────────────
# TODO: wire up Stripe Connect for creator payouts. Stubbed for MVP.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Meta Ad Library (real competitor ads) ─────────────────────
# When set, Competitive Intelligence pulls a competitor's REAL running ads
# from Meta's Ad Library during deep analysis. Get a token at
# https://www.facebook.com/ads/library/api (requires a Meta developer app +
# identity confirmation). Server-only — never expose to the client.
META_ACCESS_TOKEN=
# Comma-separated ISO country codes the ads reached (default US). Coverage is
# richest for EU-delivered ads, e.g. "US,GB,DE".
META_AD_COUNTRY=US

# ── Ahrefs (real SEO / search ground truth) ───────────────────
# When set, deep competitor analysis pulls MEASURED data from the Ahrefs API v3
# (Site Explorer): organic traffic, ranking keywords, top pages, backlinks and
# Domain Rating — for the competitor and for your own domain, plus the keyword
# gaps between them. Without it, analysis degrades to multi-page crawl + LLM.
# Create an API key at https://ahrefs.com/api (uses API units per analysis).
# Server-only — never expose to the client.
AHREFS_API_KEY=
# Default market for organic data (ISO 3166-1 alpha-2, lowercase). Default: us.
AHREFS_COUNTRY=us
# Your own domain, used to compute SEO/keyword gaps vs. a competitor. In the
# demo workspace this defaults to the sample brand's site.
SHFTD_OWN_DOMAIN=

# ── Future integrations (not used in MVP) ─────────────────────
# TODO: additional social + analytics connectors.
TIKTOK_API_TOKEN=
GA4_PROPERTY_ID=
SHOPIFY_API_KEY=
